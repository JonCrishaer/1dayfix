{
  "name": "DailyTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "target_value": {
      "type": "string",
      "description": "Quantified target (e.g., '1000 words', '30 minutes')"
    },
    "deadline_minutes": {
      "type": "number",
      "description": "Time block in minutes"
    },
    "priority": {
      "type": "number",
      "enum": [
        1,
        2,
        3
      ],
      "description": "Priority level 1-3"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "task_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title"
  ]
}